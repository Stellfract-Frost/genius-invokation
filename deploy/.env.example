# ============================================================
# 复制为 .env（与 compose.prod.yaml 同目录），然后逐项替换
#   cp .env.example .env && chmod 600 .env
# 注意：值里不要出现 $ 字符，compose 会当成变量插值。
#       生成密钥用十六进制，天然安全：
#         openssl rand -hex 32
# ============================================================

# ---------- 必填 ----------
# 镜像地址：<你的 GitHub 用户名全小写>/<fork 的仓库名全小写>
# 例：ghcr.io/wangzhiyuan/genius-invokation:latest
SERVER_IMAGE=ghcr.io/YOUR_NAME/genius-invokation:latest

# Postgres 密码：只允许字母数字，因为要拼进 DATABASE_URL
# 生成：openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME_hex_16

# JWT 签名密钥：会话令牌全靠它，泄露 = 任何人可伪造任意用户
# 生成：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_hex_32

# ---------- 可选：GitHub OAuth 登录 ----------
# 不填也能玩（平台支持匿名访客开局），只是没有 GitHub 账号体系
# 在 https://github.com/settings/developers 新建 OAuth App，
# 回调地址填 https://你的域名/  （首次登录失败时，看浏览器地址栏里
# redirect_uri 参数，照抄那一个即可）
GH_CLIENT_ID=
GH_CLIENT_SECRET=

# ---------- 可选：GitHub 访问加速 ----------
# VPS 在境内、访问 github.com 的 token 交换接口慢或超时，才需要填
# 例：GH_CODE_EXCHANGE_URL=https://gh-proxy.example.com/login/oauth/access_token
GH_CODE_EXCHANGE_URL=
GH_GET_USER_API_URL=

# ---------- 可选：调试日志回传 ----------
DEBUG_LOG_RECEIVE_URL=
